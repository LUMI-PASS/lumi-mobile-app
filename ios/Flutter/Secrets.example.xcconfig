// Template for ios/Flutter/Secrets.xcconfig, which is gitignored.
//
// Copy this file to Secrets.xcconfig and fill in the real value. The key comes
// from the Yandex Developer Dashboard (API Interfaces -> MapKit Mobile SDK) and
// is bound to the iOS bundle id registered there.
//
//   cp ios/Flutter/Secrets.example.xcconfig ios/Flutter/Secrets.xcconfig
//
// The Android counterpart is `yandexMapkitKey` in android/key.properties.

YANDEX_MAPKIT_KEY = 00000000-0000-0000-0000-000000000000

// Meta App Events. From Meta for Developers -> App settings -> Basic (App ID)
// and -> Advanced (Client token). Undefined resolves to an empty string in
// Info.plist, which FBSDKCoreKit tolerates (logs a warning, doesn't crash) —
// unlike the Android manifest placeholder, which can't be left empty. See
// docs/APPSFLYER.md for the sibling AppsFlyer setup; Meta has no doc yet.
// Also requires matching --dart-define=META_APP_ID=...
// --dart-define=META_CLIENT_TOKEN=... at build time, or MetaService.init()
// stays a no-op regardless of what's set here.
META_APP_ID = 0000000000000000
META_CLIENT_TOKEN = 00000000000000000000000000000000
