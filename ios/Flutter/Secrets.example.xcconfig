// Template for ios/Flutter/Secrets.xcconfig, which is gitignored.
//
// Copy this file to Secrets.xcconfig and fill in the real value. The key comes
// from the Yandex Developer Dashboard (API Interfaces -> MapKit Mobile SDK) and
// is bound to the iOS bundle id registered there.
//
//   cp ios/Flutter/Secrets.example.xcconfig ios/Flutter/Secrets.xcconfig
//
// The Android counterpart is `yandexMapkitKey` in android/key.properties.

YANDEX_MAPKIT_KEY = 00000000-0000-0000-0000-000000000000
