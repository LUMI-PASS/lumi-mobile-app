<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Lumi uses your location to show the centres nearest you first, and to place you on the map.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Fed from the gitignored Flutter/Secrets.xcconfig; empty when absent. -->
	<key>YandexMapKitKey</key>
	<string>$(YANDEX_MAPKIT_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Lumi</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Lumi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- ── AppsFlyer / attribution ─────────────────────────────────────────
	     Shown in the ATT prompt AppsFlyerService raises after the first frame.
	     Without an authorized verdict here iOS withholds the IDFA and installs
	     can only be attributed probabilistically. -->
	<key>NSUserTrackingUsageDescription</key>
	<string>Lumi uses this to see which ads brought you here, so we can show you classes you'll actually care about.</string>
	<!-- Routes SKAdNetwork install postbacks to AppsFlyer as well as to Apple,
	     which is what makes SKAN campaigns visible in the AppsFlyer dashboard. -->
	<key>NSAdvertisingAttributionReportEndpoint</key>
	<string>https://appsflyer-skadnetwork.com/</string>
	<!-- AppsFlyer's own SKAdNetwork id. Every ad network we buy from needs its
	     id added here too, or its installs go unattributed — copy the current
	     list from AppsFlyer → Configuration → SKAdNetwork before a campaign. -->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>su67r6k2v3.skadnetwork</string>
		</dict>
		<!-- Meta. Both ids are theirs and both are required — Meta signs
		     postbacks with either one depending on the placement. -->
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>v9wttpbfk9.skadnetwork</string>
		</dict>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>n38lu8286q.skadnetwork</string>
		</dict>
	</array>
	<!-- Meta (Facebook) SDK. The native SDK reads these at process start,
	     before any Dart runs; `MetaEnv` mirrors the first two so the Dart
	     layer can tell whether it is configured. Keep them in step —
	     see docs/META.md. -->
	<key>FacebookAppID</key>
	<string>1433809481948376</string>
	<key>FacebookClientToken</key>
	<string>8a66838afbeed59eef2fd54b76e57b1d</string>
	<key>FacebookDisplayName</key>
	<string>LumiPass</string>
	<!-- Logs install/activation and in-app purchase events without us calling
	     anything. MetaService.activateApp() is a no-op belt-and-braces on top. -->
	<key>FacebookAutoLogAppEventsEnabled</key>
	<true/>
	<!-- Lets the SDK attach the IDFA. On iOS 17+ it is still gated behind the
	     ATT verdict AppsFlyerService prompts for; without ATT this is inert
	     rather than a violation. -->
	<key>FacebookAdvertiserIDCollectionEnabled</key>
	<true/>
	<key>NSCameraUsageDescription</key>
	<string>This app needs access to your camera to take photos for your child's profile.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to your photo library to select photos for your child's profile.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>FlutterSceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>uz.lumipass.mobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>lumi</string>
			</array>
		</dict>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<!-- Maps apps the "build route" sheet hands the venue off to. iOS
		     answers canOpenURL: for a scheme only if it is declared here. -->
		<string>yandexmaps</string>
		<string>yandexnavi</string>
		<string>comgooglemaps</string>
		<!-- Facebook SDK. iOS answers canOpenURL: for a scheme only if it is
		     declared here; without these the SDK logs a warning on every
		     launch and cannot hand off to the Facebook app. -->
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>push-to-talk</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
